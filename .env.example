# ══════════════════════════════════════
# 量化交易系统环境变量配置
# 复制为 .env 并填入实际值
# ══════════════════════════════════════

# ── 数据源 ──────────────────────────
TUSHARE_TOKEN=              # Tushare Pro API token (tushare.pro)
# QMT 实盘接口（需50万+资金门槛开通）
QMT_ENABLED=false
QMT_ACCOUNT_ID=
QMT_DATA_PATH=

# ── 数据库 ──────────────────────────
REDIS_URL=redis://localhost:6379
CLICKHOUSE_URL=http://localhost:8123
CH_USER=quant
CH_PASSWORD=quant
MYSQL_URL=mysql://quant:quant@localhost:3306/quant

# ── 消息队列 ────────────────────────
REDPANDA_BROKER=localhost:9092

# ── 微服务端口 ──────────────────────
FEATURE_SERVER_PORT=50051
RISK_ENGINE_PORT=50052
NLP_SERVICE_PORT=50053
MONITOR_PORT=9090

# ── NLP 模型 ────────────────────────
# keyword: 零依赖关键词规则（默认，立即可用）
# deepseek: DeepSeek API 云端推理（推荐，准确率高，需 API key）
# Qwen/Qwen3-0.6B: 本地 Transformers 模型（需 GPU）
NLP_MODEL=keyword
NLP_DEVICE=auto

# DeepSeek API（NLP_MODEL=deepseek 时需要）
DEEPSEEK_API_KEY=             # DeepSeek API key (platform.deepseek.com)
DEEPSEEK_API_BASE=https://api.deepseek.com/v1   # API 地址

# ── 告警通知 ────────────────────────
DINGTALK_WEBHOOK=           # 钉钉群机器人 webhook URL
WEWORK_WEBHOOK=             # 企业微信机器人 webhook URL
EMAIL_SMTP_HOST=            # SMTP 服务器地址

# ── 系统 ────────────────────────────
LOG_LEVEL=INFO
ENV=dev                     # dev | staging | production

# ── 路径 ────────────────────────────
MODEL_DIR=data/models
REPORT_DIR=data/reports
PREMIUM_OUTPUT_DIR=data/premarket_recommendations
